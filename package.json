{
  "name": "@agi321/dsh-temp-chat",
  "version": "0.3.0",
  "type": "module",
  "description": "Temporary Q&A: /single-turn and /multi-turn answer via an isolated web-researching subagent; results stay in the conversation and never enter the main model context.",
  "license": "MIT",
  "author": {
    "name": "agi321.cc",
    "url": "https://github.com/agi321/dsh-temp-chat"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agi321/dsh-temp-chat.git"
  },
  "homepage": "https://github.com/agi321/dsh-temp-chat#readme",
  "bugs": {
    "url": "https://github.com/agi321/dsh-temp-chat/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "bundle",
    "slash-command"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm test"
  }
}
